VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SPOTIFY_CLIENT_ID=your-spotify-client-id
# Optional — free CARTO basemaps key from https://carto.com/basemaps/apikey/
# Required for Voyager tiles on GitHub Pages (add the same value as repo secret VITE_CARTO_API_KEY)
# VITE_CARTO_API_KEY=your-carto-basemap-key
# Web Push public key — generate with: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
